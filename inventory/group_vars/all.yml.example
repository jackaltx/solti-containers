---
# Shared variables template — copy to all.yml and customize
# cp inventory/group_vars/all.yml.example inventory/group_vars/all.yml
#
# all.yml is gitignored — site-specific overrides go there, not here

# Shared variables for all inventory hosts
# These vars apply across both localhost.yml and podma.yml inventories

# ============================================
# Shared Core Variables (sync with solti-platforms)
# These vars are consistent across all SOLTI collections
# ============================================
domain: "{{ lookup('env', 'LAB_TLD') | default('example.com', true) }}"
mylab_nolog: "{{ cluster_secure_log | bool | default(true) }}" # Controls debug output
mylab_non_ssh: false # LXC container flag

# Python interpreter (use project venv for all localhost tasks)
# ansible_python_interpreter: "{{ playbook_dir }}/solti-venv/bin/python3"

# ============================================
# Container-Specific Variables
# These vars are specific to solti-containers
# ============================================
# Container networking overrides
service_network: "ct-net"
service_dns_servers:
  - "1.1.1.1"
  - "8.8.8.8"
service_dns_search: "{{ domain }}"

# Test/verification variables
test_index: "test-ansible"
test_doc: '{"message": "Verification-{{ lookup(''pipe'', ''date +%s'') }}"}'

# Molecule testing variables — driven by env vars set by molecule
# Harmless in production (vars are only used by molecule playbooks)
testing_services: "{{ lookup('env', 'MOLECULE_SERVICES', default='redis,traefik') | split(',') }}"
project_root: "{{ lookup('env', 'MOLECULE_PROJECT_DIRECTORY', default='') }}"
report_root: "{{ lookup('env', 'MOLECULE_PROJECT_DIRECTORY', default='') }}/verify_output"
